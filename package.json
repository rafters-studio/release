{
  "name": "@rafters/release",
  "version": "0.0.0",
  "description": "Release any TypeScript project from merged work to a pushed version tag, with no config.",
  "homepage": "https://github.com/rafters-studio/release#readme",
  "bugs": {
    "url": "https://github.com/rafters-studio/release/issues"
  },
  "license": "MIT",
  "author": "Sean Silvius",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafters-studio/release.git"
  },
  "bin": {
    "release": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
